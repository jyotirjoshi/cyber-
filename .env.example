########################################################################
# Cynux environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#   make secrets        # regenerate the CHANGE-ME secrets below in place
#
# Two files, one source of truth:
#   * docker-compose.yml reads this file for ${...} interpolation
#     (postgres/minio/defectdojo wiring), and
#   * the api/worker/migrate containers load the whole file as their
#     environment, where app/core/config.py parses every CYNUX_* var.
#
# Names are EXACT. The prefix is CYNUX_ and nested settings groups use a
# double underscore: CYNUX_DB__PASSWORD, CYNUX_SCANNER__MEMORY_LIMIT_MB.
# A misspelt name is silently ignored (extra="ignore"), so match these
# precisely. List values accept either a comma-separated string or a JSON
# array.
#
# The dev placeholders below let `docker compose up` boot locally out of
# the box. THEY ARE NOT SECRET AND MUST BE REGENERATED for anything that
# leaves your laptop — `make secrets` does this, or follow the inline
# generation commands.
########################################################################

# ======================================================================
# Core application
# ======================================================================
CYNUX_ENVIRONMENT=development
CYNUX_DEBUG=true
CYNUX_API_PREFIX=/api/v1
# The externally reachable base URL of the product (used in report links,
# invite/reset links, presigned URLs). In production this MUST be https://.
CYNUX_PUBLIC_BASE_URL=http://localhost:3000
# Browser origins allowed to call the API. Must NOT contain '*' in production.
CYNUX_CORS_ORIGINS=http://localhost:3000
# Host header allow-list. '*' is fine for local; set real hostnames in production.
CYNUX_ALLOWED_HOSTS=*
CYNUX_RATE_LIMIT_PER_MINUTE=120

# ======================================================================
# Database (PostgreSQL)  — service name `postgres`
# The compose postgres service is initialised from CYNUX_DB__{USER,PASSWORD,NAME}.
# ======================================================================
CYNUX_DB__HOST=postgres
CYNUX_DB__PORT=5432
CYNUX_DB__NAME=cynux
CYNUX_DB__USER=cynux
# REQUIRED — no default. Startup is fatal without it.
#   dev placeholder below; change for anything real.
CYNUX_DB__PASSWORD=cynux_dev_password_change_me

# ======================================================================
# Redis  — service name `redis`
# ======================================================================
CYNUX_REDIS__URL=redis://redis:6379/0
# The rest have sane defaults; override only if you know why.
# CYNUX_REDIS__STREAM=cynux:agent:runs
# CYNUX_REDIS__CONSUMER_GROUP=cynux-workers
# CYNUX_REDIS__CLAIM_IDLE_MS=120000

# ======================================================================
# Security  — REQUIRED secrets, no defaults (a shared default is a backdoor)
# ======================================================================
# Signs JWT access/refresh tokens. At least 32 characters.
#   openssl rand -hex 32
CYNUX_SECURITY__JWT_SECRET=CHANGE_ME_dev_only_0123456789abcdef0123456789abcdef

# Fernet key that encrypts integration credentials at rest (SEC-001).
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CYNUX_SECURITY__CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_dev_only_0000000000000000000000000=
# Comma-separated retired keys (newest first) for zero-downtime rotation.
# CYNUX_SECURITY__CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=

# CYNUX_SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
# CYNUX_SECURITY__REFRESH_TOKEN_TTL_DAYS=14
# CYNUX_SECURITY__MIN_PASSWORD_LENGTH=12

# ======================================================================
# LLM provider  — NO DEFAULT PROVIDER, by product decision (P7).
# The API and worker BOTH refuse to start until a provider, its key, and a
# model are set. This is the one required manual step — Cynux will not guess
# which vendor to send your security data to.
# ======================================================================
CYNUX_LLM__PROVIDER=anthropic
# Set the key for the provider you selected above.
CYNUX_LLM__ANTHROPIC_API_KEY=
# CYNUX_LLM__OPENAI_API_KEY=
# CYNUX_LLM__GOOGLE_API_KEY=
# Model used for every role unless overridden below. Set the exact current
# model id your provider exposes (verify against the provider's model list).
CYNUX_LLM__DEFAULT_MODEL=claude-sonnet-4-5
# Per-role overrides (JSON). Roles: planning, reasoning, classification,
# code_remediation, report.
# CYNUX_LLM__ROLE_MODELS={"planning":"claude-opus-4-1","report":"claude-haiku-4-5"}
# CYNUX_LLM__ROLE_PROVIDERS={"report":"openai"}
# CYNUX_LLM__MAX_OUTPUT_TOKENS=4096
# CYNUX_LLM__TEMPERATURE=0.0

# ======================================================================
# Object storage (S3 / MinIO)  — REQUIRED for the worker (FR-015)
# service name `minio`. The MinIO root credentials are set from these same
# values, so the app and the object store share one credential pair locally.
# MinIO root password must be at least 8 characters.
# ======================================================================
CYNUX_STORAGE__ENDPOINT_URL=http://minio:9000
CYNUX_STORAGE__REGION=us-east-1
CYNUX_STORAGE__BUCKET=cynux-artifacts
CYNUX_STORAGE__ACCESS_KEY_ID=cynux-minio
CYNUX_STORAGE__SECRET_ACCESS_KEY=cynux_minio_dev_password_change_me
CYNUX_STORAGE__FORCE_PATH_STYLE=true
# Local MinIO has no KMS, so server-side encryption is disabled for dev.
# For real AWS S3, set this to AES256.
CYNUX_STORAGE__SSE=
# CYNUX_STORAGE__PRESIGN_TTL_SECONDS=900

# ======================================================================
# DefectDojo  — REQUIRED for the worker (FR-016), the vuln-management truth.
#
# Two ways to provide it:
#   (a) Batteries-included: `make up-defectdojo` runs the bundled DefectDojo
#       stack (compose profile `defectdojo`). Its internal URL is below.
#       Then run `make defectdojo-token` to mint an API token into .env.
#   (b) External: point BASE_URL/API_TOKEN at an instance you already run.
# ======================================================================
CYNUX_DEFECTDOJO__BASE_URL=http://defectdojo-nginx:8080
# Filled by `make defectdojo-token` for the bundled stack, or paste your own.
CYNUX_DEFECTDOJO__API_TOKEN=
# The bundled stack is plain HTTP on an internal network.
CYNUX_DEFECTDOJO__VERIFY_TLS=false
# CYNUX_DEFECTDOJO__PRODUCT_TYPE_NAME=Cynux

# ======================================================================
# Scanner sandbox (FR-012 / FR-014 / SEC-004)
# The worker spawns scanner containers on the host Docker daemon. Defaults
# are secure; override limits for your host if needed.
# ======================================================================
# Leave unset to use the mounted Docker socket. Set to tcp://docker-proxy:2375
# to run scanners through a socket proxy instead (recommended hardening).
# CYNUX_SCANNER__DOCKER_HOST=
# Egress-only network the scanners join. MUST match the compose network name.
CYNUX_SCANNER__NETWORK=cynux_scanner_net
# Host directory bind-mounted per scanner job. See CYNUX_ARTIFACT_HOST_DIR
# below — the host and in-container paths must be identical.
CYNUX_SCANNER__ARTIFACT_WORKDIR=/var/lib/cynux/artifacts
# CYNUX_SCANNER__MEMORY_LIMIT_MB=2048
# CYNUX_SCANNER__CPU_QUOTA_CORES=1.0
# CYNUX_SCANNER__MAX_CONCURRENT_JOBS_PER_ORG=4
# CYNUX_SCANNER__MAX_CONCURRENT_JOBS_GLOBAL=16
# Scanner images are pinned in config.py; override only to bump a pin.
# CYNUX_SCANNER__IMAGE_NMAP=instrumentisto/nmap:7.95

# ======================================================================
# Target policy (FR-006)
# ======================================================================
# CYNUX_TARGETS__BLOCK_PRIVATE_RANGES=true
# CYNUX_TARGETS__BLOCK_METADATA_ENDPOINTS=true
# Comma-separated. If ALLOW_LIST is non-empty, only these may ever be scanned.
# CYNUX_TARGETS__ALLOW_LIST=
# CYNUX_TARGETS__DENY_LIST=

# ======================================================================
# Threat intelligence (FR-019) — all optional; unreachable ⇒ UNAVAILABLE,
# never a negative result (FR-020).
# ======================================================================
# Optional NVD key raises the rate limit from 5/30s to 50/30s.
# CYNUX_INTEL__NVD_API_KEY=
# CYNUX_INTEL__MISP_BASE_URL=
# CYNUX_INTEL__MISP_API_KEY=

# ======================================================================
# Dify RAG knowledge base (FR-021) — optional. Unconfigured ⇒ the model is
# told "knowledge base unavailable" and may not answer from memory.
# ======================================================================
# CYNUX_DIFY__BASE_URL=
# CYNUX_DIFY__DATASET_API_KEY=
# CYNUX_DIFY__DATASET_ID=

# ======================================================================
# LangSmith agent tracing (PRD §58) — optional but strongly recommended.
# ======================================================================
# CYNUX_LANGSMITH__ENABLED=false
# CYNUX_LANGSMITH__API_KEY=
# CYNUX_LANGSMITH__PROJECT=cynux

# ======================================================================
# Jira ticketing (FR-028) — optional; unconfigured ⇒ ticket creation is rejected.
# ======================================================================
# CYNUX_JIRA__BASE_URL=
# CYNUX_JIRA__USER_EMAIL=
# CYNUX_JIRA__API_TOKEN=
# CYNUX_JIRA__PROJECT_KEY=

# ======================================================================
# Notifications (FR-029) — optional (Slack and/or SMTP).
# ======================================================================
# CYNUX_NOTIFY__SLACK_BOT_TOKEN=
# CYNUX_NOTIFY__SLACK_DEFAULT_CHANNEL=#security
# CYNUX_NOTIFY__SLACK_WEBHOOK_URL=
# CYNUX_NOTIFY__SMTP_HOST=
# CYNUX_NOTIFY__SMTP_PORT=587
# CYNUX_NOTIFY__SMTP_FROM=cynux@example.com

# ======================================================================
# OpenTelemetry (PRD §58) — optional.
# ======================================================================
# CYNUX_OTEL__ENABLED=false
# CYNUX_OTEL__ENDPOINT=http://otel-collector:4318

# ======================================================================
# Frontend (Next.js) — build/runtime wiring.
# The browser talks to the API through the public origin; the WS lives at
# the same origin under /ws. These are read by the Next.js app.
# ======================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

########################################################################
# Compose-only variables (NOT read by the app; used for ${...} wiring in
# docker-compose.yml). Kept here so there is a single env file.
########################################################################

# Host path bind-mounted into the worker for scanner artifact hand-off.
# It MUST equal CYNUX_SCANNER__ARTIFACT_WORKDIR above: the worker asks the
# host Docker daemon to bind this path into sibling scanner containers, and
# a bind source is always resolved on the host — so the in-container path
# and the host path have to be the same string.
CYNUX_ARTIFACT_HOST_DIR=/var/lib/cynux/artifacts

# Published host ports (change if they clash with something local).
CYNUX_API_PORT=8000
CYNUX_FRONTEND_PORT=3000
CYNUX_MINIO_API_PORT=9000
CYNUX_MINIO_CONSOLE_PORT=9001
CYNUX_POSTGRES_PORT=5432

# ---- Bundled DefectDojo stack (compose profile `defectdojo`) ----------
# Only used when you run `make up-defectdojo`. Pin to a released tag for
# reproducibility; verify the current tag at hub.docker.com/u/defectdojo.
DEFECTDOJO_VERSION=latest
DEFECTDOJO_PORT=8080
DEFECTDOJO_DB_PASSWORD=defectdojo_dev_password_change_me
DEFECTDOJO_ADMIN_USER=admin
DEFECTDOJO_ADMIN_PASSWORD=defectdojo_admin_change_me
DEFECTDOJO_ADMIN_MAIL=admin@cynux.local
# openssl rand -hex 32   (any long random string)
DEFECTDOJO_SECRET_KEY=CHANGE_ME_defectdojo_secret_key
DEFECTDOJO_CREDENTIAL_AES_256_KEY=CHANGE_ME_defectdojo_aes_key
